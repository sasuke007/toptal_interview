{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build main.cpp",
      "type": "shell",
      "command": "mkdir -p '${workspaceFolder}/build' && /usr/bin/clang++ -std=c++23 -g -O0 -Wall -Wextra -DLOCAL '${workspaceFolder}/main.cpp' -o '${workspaceFolder}/build/main'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
